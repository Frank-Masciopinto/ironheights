{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ironheights.invalid/labels.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["skills"],
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "label"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "label": { "enum": ["malicious", "benign"] },
          "family": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
