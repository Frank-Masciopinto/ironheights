{
  "name": "ironheights",
  "version": "0.1.0",
  "description": "Local-first security scanner and integrity monitor for OpenClaw skills.",
  "homepage": "https://ironheights.dev",
  "bugs": {
    "url": "https://github.com/Frank-Masciopinto/ironheights/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frank-Masciopinto/ironheights.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "ironheights": "dist/cli/index.js",
    "ih": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:rules": "tsup scripts/generate-rules-doc.ts --no-config --format esm --target node20 --out-dir dist-scripts --clean --silent && node dist-scripts/generate-rules-doc.js"
  },
  "dependencies": {
    "commander": "14.0.3",
    "picomatch": "4.0.4",
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.1.11"
  }
}
